# --- Database (Dokploy-deployed Postgres) ---
# Standard Postgres connection string. Use the Dokploy Postgres service as host.
DATABASE_URL=postgres://kauppalista:replace-with-postgres-password@postgres:5432/kauppalista?sslmode=disable

# --- API server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=9000

# --- Auth0 (API) ---
AUTH0_ISSUER=https://your-tenant.auth0.com/
AUTH0_API_AUDIENCE=kauppalista-api
AUTH0_MANAGEMENT_AUDIENCE=https://your-tenant.auth0.com/api/v2/
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=replace-with-auth0-management-client-secret

# --- Client build-time Auth0 settings ---
VITE_AUTH_AUTHORITY=https://your-tenant.auth0.com/
VITE_AUTH_CLIENT_ID=your-spa-client-id
VITE_AUTH_SCOPE=openid profile email
VITE_AUTH_AUDIENCE=kauppalista-api
